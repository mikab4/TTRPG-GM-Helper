#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/hook-common.sh"

declare -A seen_files=()
backend_files=()

while IFS= read -r -d '' repository_path; do
  case "$repository_path" in
    backend/*.py)
      backend_path="${repository_path#backend/}"
      if [[ -z "${seen_files[$backend_path]+present}" ]]; then
        backend_files+=("$backend_path")
        seen_files["$backend_path"]=1
      fi
      ;;
  esac
done < <(
  git diff HEAD --name-only --diff-filter=ACMR -z
  git ls-files --others --exclude-standard -z
)

if [[ ${#backend_files[@]} -eq 0 ]]; then
  allow_stop
fi

quality_log="$(mktemp)"
trap 'rm -f "$quality_log"' EXIT
export UV_CACHE_DIR="${TMPDIR:-/tmp}/rpg-gm-helper-uv-cache"

if (
  cd backend
  uv run -q ruff check --fix "${backend_files[@]}" &&
    uv run -q ruff format "${backend_files[@]}" &&
    uv run -q ruff format --check "${backend_files[@]}" &&
    uv run -q ruff check "${backend_files[@]}"
) >"$quality_log" 2>&1; then
  allow_stop
fi

block_stop "Backend auto-formatting or Ruff checks failed for changed Python files. Remaining Ruff output:" "$quality_log"
