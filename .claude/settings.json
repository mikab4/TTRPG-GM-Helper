{
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run alembic current *)",
      "Bash(uv run alembic history *)",
      "Bash(uv run alembic heads *)",
      "Bash(uv run alembic check *)",
      "Bash(uv run alembic revision *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run format:check *)",
      "Bash(npm run build *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/run-backend-quality",
            "statusMessage": "Formatting and checking changed backend files",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/run-frontend-quality",
            "statusMessage": "Formatting and checking changed frontend files",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
