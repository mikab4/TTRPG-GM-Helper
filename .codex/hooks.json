{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/run-backend-quality",
            "statusMessage": "Formatting and checking changed backend files",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/run-frontend-quality",
